{
  "name": "visor-web",
  "version": "3.0.1",
  "description": "Programa para abrir el POS en la web e imprimir tickets",
  "scripts": {
    "start": "electron main.js",
    "build": "npm run sign:catalog && electron-builder --dir .",
    "build:print": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Build-PrintService.ps1",
    "sign:catalog": "node scripts/Sign-StoreCatalog.js",
    "test": "node --check main.js && node --check local-runtime.js && node --check profile-store.js && node --check enrollment-runtime.js && node --check preload.js && node --check vistas/startup.js && node --check vistas/status.js && node --test tests/*.test.js",
    "instalar": "npm run sign:catalog && npm run build:print && electron-builder --win"
  },
  "author": "Francisco Javier Terrones Díaz",
  "license": "ISC",
  "build": {
    "appId": "com.terronesdiaz.visorweb",
    "icon": "logo.png",
    "publish": [
      {
        "provider": "generic",
        "url": "https://tunkitos.terrones.dev/lanzamientos/"
      }
    ],
    "files": [
      "main.js",
      "main-window.js",
      "docker-settings.js",
      "logo.png",
      "local-runtime.js",
      "profile-store.js",
      "enrollment-runtime.js",
      "store-catalog.json",
      "store-catalog.json.sig",
      "update-runtime.js",
      "update-public-key.xml",
      "logo-store.js",
      "preload.js",
      "./python-print/**/*",
      "./node_modules/**/*",
      "./vistas/**/*",
      "libusb-1.0.dll",
      "package.json",
      "package-lock.json",
      "appURLs.json"
    ],
    "extraResources": [
      {
        "from": "dist/print-service/terrones-print-service.exe",
        "to": "print-service/terrones-print-service.exe"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "appURLs.json"
    ]
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "winston": "^3.19.0"
  },
  "main": "main.js"
}
